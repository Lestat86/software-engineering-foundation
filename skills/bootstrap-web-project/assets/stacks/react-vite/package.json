{
  "name": "{{PROJECT_NAME}}",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@{{YARN_VERSION}}",
  "engines": {
    "node": "{{NODE_ENGINES}}"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "yarn lint:foundation && yarn lint:code && yarn lint:secrets",
    "lint:code": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "lint:foundation": "node .config/foundation/check-foundation.mjs",
    "lint:secrets": "secretlint --secretlintignore .gitignore \"**/*\"",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate": "yarn lint && yarn typecheck && yarn test && yarn build",
    "postinstall": "husky"
  },
  "dependencies": {},
  "devDependencies": {}
}
